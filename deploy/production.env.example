APP_NAME=FBWeb
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_DOMAIN=example.com
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=fbweb
DB_USERNAME=fbweb
DB_PASSWORD=REPLACE_UNIQUE_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_DIFFERENT_LONG_RANDOM_PASSWORD
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
