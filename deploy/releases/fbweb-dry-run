#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    echo "Usage: fbweb-dry-run MANIFEST_PATH" >&2
    exit 2
fi

exec /usr/bin/python3 -B \
    /usr/local/lib/fbweb-deploy/controller.py \
    "$1" \
    --approval-dir /etc/fbweb-deploy/approvals \
    --authorization-dir /etc/fbweb-deploy/authorizations
